# Copy to .env (same folder) and fill in. Read at build time by
# src-tauri/build.rs; a variable already set in the shell wins. Never commit .env.

# Google OAuth client for cloud sync (docs/google-cloud.md). Leave empty to
# build without the Sync section.
MEMO_GOOGLE_CLIENT_ID=
MEMO_GOOGLE_CLIENT_SECRET=
MEMO_GOOGLE_WEB_CLIENT_ID=
