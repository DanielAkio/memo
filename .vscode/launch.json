{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run in dev mode",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Stop the running dev Memo",
      "command": "npm install --no-audit --no-fund; npm run dev"
    },
    {
      "name": "Run site / web app",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "npm run web",
      "serverReadyAction": {
        "pattern": "Memo Site running at (https?://[^\\s]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Build Windows installer (Docker)",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "command": "docker compose -f docker/compose.yml run --build --rm windows"
    }
  ]
}
