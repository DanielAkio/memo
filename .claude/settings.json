{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "bashOutputMaxChars": 15000,
  "permissions": {
    "deny": [
      "Read(/src/vendor/**)",
      "Read(/src-tauri/icons/**)",
      "Read(/assets/**)",
      "Read(/src-tauri/Cargo.lock)",
      "Read(/package-lock.json)",
      "Read(/src-tauri/target/**)",
      "Read(/src-tauri/gen/**)",
      "Read(/node_modules/**)",
      "Read(/dist/**)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.ai/hooks/regression-test.mjs\""
          }
        ]
      }
    ]
  }
}
