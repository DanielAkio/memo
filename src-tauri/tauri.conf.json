{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memo",
  "version": "0.10.0",
  "identifier": "br.memo.notas",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage"],
    "category": "Productivity",
    "shortDescription": "Sticky memories that stay on top of everything",
    "longDescription": "Memo keeps your memories in sticky notes for Windows, macOS and Linux. Each memory is its own window, and one click on the pin keeps it on top of every other app.",
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "languages": ["English", "PortugueseBR"],
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCQ0U4NkQwNTRFRDY2MjIKUldRaVp1MVUwSWJPbTA3azdKWHpRa2dST25mSWszZHEyVjIxVHVBL3AxUSs0eUJwcS8wclNYdk8K",
      "endpoints": ["https://github.com/DanielAkio/memo/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
