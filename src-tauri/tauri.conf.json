{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Taxinha",
  "version": "0.1.0",
  "identifier": "br.taxinha.notas",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Notas adesivas que ficam por cima de tudo",
    "longDescription": "Taxinha é um bloco de notas adesivas para Windows, macOS e Linux. Cada nota é uma janela própria, e um clique na tachinha a mantém por cima de todos os outros aplicativos.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
